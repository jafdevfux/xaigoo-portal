{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/xaigoo-extractor.zip",
      "dest": "/xaigoo-extractor.zip",
      "continue": false
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "continue": false
    }
  ],
  "headers": [
    {
      "source": "/xaigoo-extractor.zip",
      "headers": {
        "Content-Type": "application/zip",
        "Content-Disposition": "attachment; filename=\"xaigoo-extractor.zip\""
      }
    }
  ]
}